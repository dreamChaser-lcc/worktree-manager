{
  "name": "worktree-manager-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Worktree 管理器桌面端（Electron 壳：内嵌现有 Koa 服务与 web/dist，双击即用）",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lcc.worktree-manager",
    "productName": "Worktree Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": ["src/**", "package.json", "node_modules/**"]
      },
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
